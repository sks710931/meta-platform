# Local development only. Replace the password before starting PostgreSQL.
POSTGRES_DB=whatsapp_platform
POSTGRES_USER=whatsapp_platform
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
# Keep this password in sync with POSTGRES_PASSWORD. The host runs outside Compose.
ConnectionStrings__Platform="Host=127.0.0.1;Port=5432;Database=whatsapp_platform;Username=whatsapp_platform;Password=replace-with-a-local-password"
ASPNETCORE_URLS=http://127.0.0.1:5080
ASPNETCORE_ENVIRONMENT=Development

# Optional explicit bootstrap: supply actual values through untracked local environment/secrets.
# BootstrapAdmin__Email=replace-with-admin-email
# BootstrapAdmin__Password=replace-with-a-strong-secret
# Production requires a restricted persistent, encrypted key-ring volume.
# DataProtection__KeyDirectory=replace-with-protected-key-directory
# Development-only fixture; Organization must already exist.
# DevelopmentMember__Email=replace-with-member-email
# DevelopmentMember__Password=replace-with-a-strong-secret
# DevelopmentMember__OrganizationId=replace-with-organization-uuid
# DevelopmentMember__Role=Member

# Optional Meta Embedded Signup v4. Supply all four, or leave all unset to disable.
# Meta__AppId=replace-with-meta-app-id
# Meta__AppSecret=replace-with-meta-app-secret
# Meta__EmbeddedSignupConfigurationId=replace-with-v4-login-configuration-id
# Meta__GraphApiVersion=replace-with-supported-graph-version
# Real Meta onboarding requires a persistent key directory even in Development.
# Production additionally requires a key-encryption certificate (keep it outside source control).
# DataProtection__CertificatePath=replace-with-private-pfx-path
# DataProtection__CertificatePassword=replace-with-certificate-secret
