# Local development only. Replace the password before starting PostgreSQL.
POSTGRES_DB=whatsapp_platform
POSTGRES_USER=whatsapp_platform
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
# Keep this password in sync with POSTGRES_PASSWORD. The host runs outside Compose.
ConnectionStrings__Platform="Host=127.0.0.1;Port=5432;Database=whatsapp_platform;Username=whatsapp_platform;Password=replace-with-a-local-password"
ASPNETCORE_URLS=http://127.0.0.1:5080
ASPNETCORE_ENVIRONMENT=Development
